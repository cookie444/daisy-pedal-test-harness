<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Daisy HIL report &mdash; {{ report.backend }}</title>
<style>
  :root {
    --pass: #2a9d8f; --fail: #d1495b; --ink: #1d2d35; --muted: #6b7c85;
    --line: #e3e8ea; --bg: #f7f9fa; --card: #ffffff;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 24px 32px 64px; background: var(--bg); color: var(--ink);
         font: 14px/1.5 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 32px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .sub { color: var(--muted); font-size: 13px; margin-bottom: 20px; }
  .cards { display: flex; gap: 12px; flex-wrap: wrap; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px;
          padding: 12px 18px; min-width: 130px; }
  .card .k { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; }
  .card .v { font-size: 22px; font-weight: 600; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; color: #fff;
           font-size: 11px; font-weight: 600; letter-spacing: .04em; }
  .badge.pass { background: var(--pass); } .badge.fail { background: var(--fail); }
  table { width: 100%; border-collapse: collapse; background: var(--card);
          border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); font-size: 13px; }
  th { background: #eef3f5; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  tr:last-child td { border-bottom: none; }
  td.num { font-variant-numeric: tabular-nums; text-align: right; }
  tr.fail td { background: #fdf3f4; }
  .group { margin: 28px 0 0; }
  .figure { background: var(--card); border: 1px solid var(--line); border-radius: 8px;
            padding: 12px; margin: 12px 0; }
  .figure img { width: 100%; height: auto; display: block; }
  .figure .cap { color: var(--muted); font-size: 12px; margin-top: 8px; }
  pre { background: var(--card); border: 1px solid var(--line); border-radius: 8px;
        padding: 12px; overflow-x: auto; font-size: 12px; }
  .muted { color: var(--muted); }
</style>
</head>
<body>
<h1>Daisy Pod HIL report</h1>
<div class="sub">
  backend <strong>{{ report.backend }}</strong> &middot; {{ report.sample_rate }} Hz &middot;
  {{ report.started_at }} &middot; {{ "%.2f"|format(report.duration_s) }} s
  {% if report.environment.get("faults_active") %}<strong style="color:var(--fail)"> &middot; fault injection active</strong>{% endif %}
</div>

<div class="cards">
  <div class="card"><div class="k">Result</div>
    <div class="v"><span class="badge {{ 'pass' if report.passed else 'fail' }}">{{ "PASS" if report.passed else "FAIL" }}</span></div></div>
  <div class="card"><div class="k">Specs</div><div class="v">{{ counts.total }}</div></div>
  <div class="card"><div class="k">Passed</div><div class="v" style="color:var(--pass)">{{ counts.passed }}</div></div>
  <div class="card"><div class="k">Failed</div><div class="v" style="color:{{ 'var(--fail)' if counts.failed else 'var(--muted)' }}">{{ counts.failed }}</div></div>
</div>

<h2>Specs</h2>
<table>
<thead><tr>
  <th>Group</th><th>Spec</th><th class="num">Measured</th><th class="num">Expected</th>
  <th class="num">Window</th><th>Status</th><th>Notes</th>
</tr></thead>
<tbody>
{% for spec in report.results %}
<tr class="{{ 'pass' if spec.passed else 'fail' }}">
  <td>{{ spec.group }}</td>
  <td><strong>{{ spec.name }}</strong></td>
  <td class="num">{{ fmt(spec.value) }}{{ spec.unit }}</td>
  <td class="num">{{ fmt(spec.expected) }}</td>
  <td class="num">{{ fmt(spec.lower) }} &hellip; {{ fmt(spec.upper) }}</td>
  <td><span class="badge {{ 'pass' if spec.passed else 'fail' }}">{{ spec.status }}</span></td>
  <td class="muted">{{ spec.notes }}</td>
</tr>
{% endfor %}
</tbody>
</table>

{% for group, specs in report.by_group().items() %}
<div class="group">
  <h2>{{ group }}</h2>
  {% for spec in specs %}
    {% if spec.figures %}
      {% for figure in spec.figures %}
      <div class="figure">
        <img src="data:image/png;base64,{{ figure.png }}" alt="{{ figure.title }}">
        <div class="cap"><strong>{{ figure.title }}</strong>{% if figure.caption %} &mdash; {{ figure.caption }}{% endif %}</div>
      </div>
      {% endfor %}
    {% endif %}
  {% endfor %}
</div>
{% endfor %}

<h2>Environment</h2>
<pre>{{ env_yaml }}</pre>

<h2>Rig configuration</h2>
<pre>{{ config_yaml }}</pre>
</body>
</html>
